{
  "name": "artemis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "npm run build:web",
    "build:web": "vite build --config src/web/vite.config.ts",
    "migrate": "tsx scripts/migrate.ts",
    "start": "tsx src/server.ts",
    "start:container": "npm run migrate && tsx src/server.ts",
    "session:start": "tsx scripts/session-orchestrator/index.ts start",
    "session:audit": "tsx scripts/session-orchestrator/index.ts audit",
    "session:handoff": "tsx scripts/session-orchestrator/index.ts handoff",
    "session:next-prompt": "tsx scripts/session-orchestrator/index.ts next-prompt",
    "deploy:check-env": "tsx scripts/deploy/check-env.ts",
    "deploy:smoke": "tsx scripts/deploy/smoke-test.ts",
    "landing:create-code": "tsx scripts/landing/create-whitelist-code.ts",
    "db:backup": "bash scripts/deploy/backup-db.sh",
    "db:restore": "bash scripts/deploy/restore-db.sh",
    "format": "prettier --write .",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "vitest run --config vitest.config.ts",
    "test:e2e": "npm run migrate && playwright test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@sentry/node": "^9.18.0",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-router": "^1.97.0",
    "@tanstack/router-devtools": "^1.97.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "file-type": "^19.6.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.4.3",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,css,yml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js}": [
      "eslint --fix"
    ]
  }
}
