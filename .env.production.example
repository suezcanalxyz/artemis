NODE_ENV=production
APP_URL=https://app.artemis.network
WEB_URL=https://app.artemis.network
ARTEMIS_BASE_DOMAIN=artemis.network

PORT=3000

DATABASE_URL=postgres://artemis:CHANGE_ME@postgres:5432/artemis
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=artemis:

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
ACCESS_TOKEN_TTL=24h
REFRESH_TOKEN_TTL=30d

UPLOAD_ROOT=/app/uploads
MAX_UPLOAD_MB=50

AI_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

SENTRY_DSN=
CADDY_ASK_TOKEN=CHANGE_ME_PLEASE_WITH_A_LONG_SECRET
DOMAIN_VERIFICATION_CNAME_TARGET=verify.artemis.network
START_WORKERS=true
